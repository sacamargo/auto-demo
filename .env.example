# Supabase (público — seguro en el cliente)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy alias also supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sitio (local). En Vercel ya está definido en config/site.ts como https://auto-demo-six.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=573028621190

# Solo servidor — NUNCA usar prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
REVALIDATE_SECRET=generate-a-random-secret

# Alertas de lead (solo servidor) — Resend: https://resend.com
ADMIN_ALERT_EMAIL=admin@example.com
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=AutoDemo <onboarding@resend.dev>
